# ---- Watchmuse configuration ----
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8080
# Public origin users hit; used for OAuth redirect URLs and email links.
APP_URL=http://localhost:8080

# Persistence. Default is embedded PGlite (no external DB needed).
# For production Postgres: postgres://user:pass@host:5432/watchmuse
DATABASE_URL=pglite://./data/pg
# REDIS_URL=redis://localhost:6379

# Secrets — generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# openssl rand -base64 48
SESSION_SECRET=

# Real client IP behind a proxy. Keywords: cloudflare, loopback, private.
# Behind Cloudflare set: TRUSTED_PROXIES=cloudflare
TRUSTED_PROXIES=
TRUST_CLOUDFLARE_HEADER=true

# Registration / abuse controls
REGISTRATION_ENABLED=true
# Require a confirmed email address before sign-in. Leave on for any instance
# other people can register on. A single-user self-host with no mail relay can
# set this to false.
REQUIRE_EMAIL_VERIFICATION=true
SIGNUP_RATE_PER_HOUR=10
MAX_CONCURRENT_SYNCS_GLOBAL=4
MAX_CONCURRENT_SYNCS_PER_USER=1
MIN_SCHEDULE_INTERVAL_MINUTES=15

# SMTP (Brevo relay uses port 587 STARTTLS -> SMTP_SECURE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Watchmuse <no-reply@example.com>

# Providers — register apps and paste credentials.
# Trakt: https://trakt.tv/oauth/applications
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Simkl: https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# TMDB v3 API key — metadata + candidate generation. Get one at themoviedb.org/settings/api
TMDB_API_KEY=
APP_NAME=Watchmuse
APP_VERSION=0.1.0

# Prometheus metrics at /metrics. Off by default: the series carry user counts,
# provider error rates and route traffic. Set METRICS_TOKEN to require
# `Authorization: Bearer <token>` when the endpoint is reachable from outside.
METRICS_ENABLED=false
METRICS_TOKEN=
